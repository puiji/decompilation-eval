# Boktai 2 (GBA). Run: audit/agbcc/eval.sh audit/targets/boktai2.env
NAME=boktai2
FAMILY=agbcc
REPO=https://github.com/akatsuki105/boktai2
PIN=f107ada7
FORK_REPO=https://github.com/akatsuki105/agbcc
FORK_SHA=9915d1b3
PREPROC=1
CFLAGS="-mthumb-interwork -Wimplicit -Wparentheses -Werror -O2 -fhex-asm"
OVERRIDES=$'src/sprite_main_arm.c|agbcc_arm|-O2 -mthumb-interwork -quiet\nsrc/lib/librfu_intr.c|agbcc_arm|-O2 -mthumb-interwork -quiet\nsrc/lib/agb_eeprom.c|agbcc|-O -mthumb-interwork'
SDK_RE='^lib_'
