# Kirby: Nightmare in Dream Land (GBA). Run: audit/agbcc/eval.sh audit/targets/knidl.env
NAME=knidl
FAMILY=agbcc
REPO=https://github.com/overjt/knidl
PIN=628f4d46
FORK_REPO=https://github.com/jiangzhengwenjz/agbcc
FORK_SHA=59b966ed
CFLAGS="-O2 -mthumb-interwork -fprologue-bugfix -Wimplicit -Wparentheses -Werror -fhex-asm"
OVERRIDES=$'src/agb_sram.c|old_agbcc|-O1 -mthumb-interwork\nsrc/m4a_c1.c|old_agbcc|-O2 -mthumb-interwork\nsrc/m4a_cgb.c|old_agbcc|-O2 -mthumb-interwork\nsrc/m4a_ctrl.c|old_agbcc|-O2 -mthumb-interwork'
SDK_RE='^(agb_sram|m4a_c1|m4a_cgb|m4a_ctrl)$'
